{
  "name": "icloud-mail-mcp",
  "private": true,
  "version": "0.1.0",
  "description": "MCP server exposing iCloud Mail (IMAP/SMTP) as tools for Claude",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "auth": "tsx src/cli/auth.ts",
    "auth:check": "tsx src/cli/auth.ts --check",
    "verify:imap": "tsx src/dev/verify-imap.ts",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "test:watch": "node --import tsx --test --watch \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "html-to-text": "10.0.1",
    "imapflow": "^1.7.6",
    "mailparser": "^3.9.17",
    "nodemailer": "^9.1.0",
    "pino": "^10.3.1",
    "zod": "^4.5.4"
  },
  "overrides": {
    "html-to-text": "10.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "Léo Lesimple"
}
