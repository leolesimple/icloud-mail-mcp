# Copier en .env (jamais commité) et renseigner les identifiants et l'URL du serveur mail.

# --- Identifiant / adresse mail ----------------------------------------------
# Adresse email complète du compte (identifiant IMAP et SMTP).
MAIL_EMAIL=

# --- Mot de passe du compte ---------------------------------------------------
# Mot de passe du compte, ou mot de passe d'application si le fournisseur
# l'impose. Pour iCloud : à générer sur https://appleid.apple.com/
# -> "Connexion et sécurité" -> "Mots de passe pour applications".
MAIL_PASSWORD=

# --- Connexion IMAP ----------------------------------------------------------
# Renseignez l'adresse du serveur de réception et le port. 993 est le port SSL/TLS standard.
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993

# Nombre max de connexions IMAP maintenues dans le pool (réutilisées entre les
# appels d'outils).
# La recherche multi-dossiers (find_messages folders) utilise toutes les
# connexions sauf une : 4 est recommandé si on cherche souvent sur tous les dossiers.
IMAP_POOL_SIZE=2

# Attente maximale (ms) d'une connexion libre quand le pool est plein. Au-delà,
# l'appel échoue avec "Pool IMAP saturé" au lieu de rester bloqué.
IMAP_ACQUIRE_TIMEOUT_MS=60000

# --- Connexion SMTP -----------------------------------------------------------
# Renseignez l'adresse du serveur d'envoi. Utilise MAIL_EMAIL / MAIL_PASSWORD
# pour l'authentification (mêmes identifiants que l'IMAP).
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
SMTP_POOL_SIZE=2

# --- Transport MCP ------------------------------------------------------------
# http  : serveur HTTP streamable (défaut, cf. déploiement de référence).
# stdio : serveur JSON-RPC sur stdin/stdout, pour un client MCP local.
# both  : les deux en parallèle.
# En stdio, les logs basculent automatiquement sur stderr : stdout porte le
# canal JSON-RPC et la moindre ligne parasite le corromprait.
MCP_TRANSPORT=http

# --- Serveur HTTP MCP -----------------------------------------------------------
# Port d'écoute interne au conteneur. Le docker-compose ne l'expose pas
# directement : tout passe par le sidecar cloudflared (voir plus bas).
# Ignoré si MCP_TRANSPORT=stdio.
PORT=13316

# Plafond par défaut, en caractères, du corps renvoyé par get_message.
# Surchargeable par appel via le paramètre maxBodyChars.
MAX_BODY_CHARS=20000

# Token statique requis pour tout appel à l'endpoint /mcp, dans le header
# "Authorization: Bearer <token>" ou "X-Api-Key: <token>" (jeton brut, pour les
# connecteurs claude.ai qui interdisent Authorization). Généré avec :
#   openssl rand -hex 32
MCP_BEARER_TOKEN=

# Requêtes /mcp autorisées par IP et par minute (fenêtre glissante). Au-delà : 429.
# /health n'est jamais limité. Généreux par défaut.
RATE_LIMIT_PER_MINUTE=120

# Inactivité (ms) au-delà de laquelle une session MCP est évincée et son
# transport fermé. Empêche la Map de sessions de fuir. 30 min par défaut.
SESSION_TTL_MS=1800000

# --- Garde-fous d'envoi -------------------------------------------------------
# Évalués dans cet ordre par send_message / reply_message (voir docs/security.md).

# Coupe-circuit historique : à false, aucun message n'est transmis.
ENABLE_SENDING=false

# À true : au lieu d'envoyer, le message est composé et déposé dans Drafts.
# L'outil renvoie un succès ({ sent: false, reason: "DRAFTS_ONLY" }) : la
# rédaction n'est jamais perdue. Mode le plus sûr.
DRAFTS_ONLY=false

# Liste blanche de destinataires, séparés par des virgules. Vide = aucune
# restriction. Adresse exacte (alice@example.com) ou domaine entier
# (@example.com, hors sous-domaines). Un destinataire to/cc/bcc hors liste
# fait échouer l'envoi, en nommant l'adresse fautive.
ALLOWED_RECIPIENTS=

# Nombre max d'envois réussis sur 24 h glissantes. 0 = illimité.
MAX_SENDS_PER_DAY=0

# Fichier où persister le quota d'envoi pour qu'il survive aux redémarrages.
# Vide = compteur en mémoire, remis à zéro au redémarrage. Le docker-compose.yml
# le fixe déjà à /app/data/send-quota.json (volume icloud-mail-mcp-data).
QUOTA_STATE_PATH=

# Mode de test "sans filet" : désactive ENABLE_SENDING, DRAFTS_ONLY,
# ALLOWED_RECIPIENTS et MAX_SENDS_PER_DAY. Ne désactive jamais le rate limit,
# les limites de ressources HTTP, l'auth bearer ni le TTL des sessions. Chaque
# envoi est alors précédé d'un log warn. À n'utiliser que sur une instance jetable.
UNRESTRICTED=false

# --- Jetons de confirmation ---------------------------------------------------
# Secret HMAC des jetons qui confirment les opérations destructives (vidage de
# corbeille, suppression définitive, envoi). Au moins 32 caractères. Vide = un
# secret aléatoire est tiré à chaque démarrage (les jetons, valables 2 min, ne
# survivent alors pas à un redémarrage). Ne pas réutiliser MCP_BEARER_TOKEN ni
# le mot de passe du compte. Généré avec :
#   openssl rand -hex 32
CONFIRM_SECRET=

# Confirmation par formulaire (élicitation MCP) quand le client l'annonce.
# auto : formulaire ; si le client ne répond pas dans ELICITATION_TIMEOUT_MS
#        (client qui annonce la capacité sans afficher le formulaire, comme
#        claude.ai), repli sur le jeton pour le reste de la session.
# off  : jamais de formulaire, toujours le jeton en deux temps.
ELICITATION=auto
# Attente maximale de la réponse au formulaire (ms). Doit rester sous le
# timeout de requête du client (60 s pour claude.ai).
ELICITATION_TIMEOUT_MS=20000

# --- Liens de téléchargement ------------------------------------------------
# Secret HMAC des liens signés de get_attachment (format "url"), servis par
# GET /download/<jeton> : valables 15 min, à usage unique. Au moins 32
# caractères. Vide = un secret aléatoire est tiré à chaque démarrage (les liens
# ne survivent alors pas à un redémarrage). Le format "url" exige aussi
# PUBLIC_BASE_URL. Généré avec :
#   openssl rand -hex 32
DOWNLOAD_URL_SECRET=

# --- Dépôts de fichiers (create_upload_link) ----------------------------------
# Les fichiers déposés par POST /upload/<jeton> sont gardés EN MÉMOIRE 1 h (ou
# jusqu'à l'envoi du mail qui les attache) et perdus au redémarrage. Plafonds :
# nombre de dépôts conservés à la fois, et octets cumulés (défaut : 50 Mio).
# Chaque fichier reste borné par ATTACHMENT_MAX_BYTES.
UPLOAD_MAX_FILES=20
UPLOAD_MAX_TOTAL_BYTES=52428800

# Active l'outil wait_for_new_message (attente IDLE sur une connexion dédiée
# hors pool). OFF par défaut : cette version n'a pas de reconnexion, donc
# l'attente se dégrade silencieusement si la connexion saute. Voir
# docs/configuration.md.
ENABLE_IDLE_WATCH=false

# URL publique HTTPS du serveur, sans slash final (ex. https://mail-mcp.exemple.com).
# Optionnelle : renseigne icons/websiteUrl dans les métadonnées MCP
# (Implementation), pour les clients qui les affichent (favicon du connecteur),
# et sert de base aux liens de get_attachment (format "url") et de
# create_upload_link.
# Vide = ces champs ne sont pas envoyés et le format "url" est refusé.
PUBLIC_BASE_URL=

# --- Déploiement (docker-compose) ---------------------------------------------
# Tag de l'image GHCR tirée par docker-compose.yml. Une version précise
# ("0.1.0") pour épingler, "latest" pour suivre le dernier tag publié.
ICLOUD_MAIL_MCP_VERSION=latest

# Nom du réseau Docker partagé avec le cloudflared qui gère le tunnel (stack
# tierce, hors de ce projet). Le serveur s'y rattache pour être joignable en
# http://icloud-mail-mcp:13316. Le réseau doit déjà exister :
#   docker network create "<ce nom>"
# REQUIS (docker-compose.yml échoue sans).
TUNNEL_NETWORK=

# Token du tunnel Cloudflare (dashboard Zero Trust -> Networks -> Tunnels).
# Utilisé UNIQUEMENT par le cloudflared embarqué de docker-compose.tunnel.yml
# (déploiement autonome). Inutile si le tunnel est géré ailleurs.
TUNNEL_TOKEN=

# --- Logs ---------------------------------------------------------------------
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Divers -------------------------------------------------------------------
# Taille maximale d'une pièce jointe, en octets (défaut : 5 Mio).
ATTACHMENT_MAX_BYTES=5242880

# HTTP listens locally outside Docker; Docker overrides HTTP_HOST.
HTTP_HOST=127.0.0.1
# Trust only exact proxy socket IPs/CIDRs; never use a hop count or 0.0.0.0/0.
# For cloudflared set its fixed Docker IP here, e.g. 172.28.0.2/32.
TRUSTED_PROXIES=
# Hostnames (no ports) accepted by HTTP. PUBLIC_BASE_URL host is included automatically.
HTTP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],icloud-mail-mcp
# Exact additional browser Origins; absent Origin is accepted for native MCP clients.
HTTP_ALLOWED_ORIGINS=
HTTP_MAX_CONCURRENT_REQUESTS=4
HTTP_BODY_MAX_BYTES=8388608
MAX_SESSIONS=32
MAX_MESSAGE_BYTES=26214400
IMAP_MAX_WAITERS=32
UPLOAD_TIMEOUT_MS=30000
