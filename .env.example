# Copier en .env (jamais commit) et renseigner au minimum les identifiants iCloud.

# --- Identifiants iCloud ----------------------------------------------------
# Identifiant Apple ID complet (adresse email).
ICLOUD_EMAIL=

# Mot de passe d'application (PAS le mot de passe principal du compte Apple).
# A generer sur https://appleid.apple.com/ -> "Connexion et securite"
# -> "Mots de passe pour applications".
ICLOUD_APP_PASSWORD=

# --- Connexion IMAP ----------------------------------------------------------
# Valeurs par defaut correctes pour iCloud, a ne changer que si besoin.
IMAP_HOST=imap.mail.me.com
IMAP_PORT=993

# Nombre max de connexions IMAP maintenues dans le pool (reutilisees entre les
# appels d'outils). iCloud throttle agressivement les connexions simultanees :
# ne pas monter trop haut.
IMAP_POOL_SIZE=2

# --- Connexion SMTP -----------------------------------------------------------
# Valeurs par defaut correctes pour iCloud. Utilise ICLOUD_EMAIL / ICLOUD_APP_PASSWORD
# pour l'authentification (mêmes identifiants que l'IMAP).
SMTP_HOST=smtp.mail.me.com
SMTP_PORT=587
SMTP_POOL_SIZE=2

# --- Serveur HTTP MCP -----------------------------------------------------------
# Port d'ecoute interne au conteneur. Le docker-compose ne l'expose pas
# directement : tout passe par le sidecar cloudflared (voir plus bas).
PORT=3000

# Token statique requis dans le header "Authorization: Bearer <token>" pour
# tout appel au endpoint /mcp. Genere avec : openssl rand -hex 32
MCP_BEARER_TOKEN=

# Coupe-circuit pour l'envoi : passer a false desactive send_message et
# reply_message (les deux renvoient une erreur claire), le reste des outils
# n'est pas affecte. Par defaut a true.
ENABLE_SENDING=true

# --- Cloudflare Tunnel (docker-compose) -----------------------------------------
# Token du tunnel, genere dans le dashboard Cloudflare Zero Trust
# (Networks -> Tunnels -> Créer un tunnel -> Docker). Utilise uniquement par
# le service "cloudflared" du docker-compose.yml, pas par l'app elle-même.
TUNNEL_TOKEN=

# --- Logs ---------------------------------------------------------------------
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
